{
  name: "Acme Corp",
  slug: "acme-corp",
  description: "AI-native software consultancy",
  mission: "Deliver high-quality software products autonomously",

  // Company-wide integrations — agents can override per-integration settings
  integrations: {
    slack: {
      workspace: "acme-corp",
      defaultChannel: "general",
      channels: ["general", "engineering", "leadership"],
    },
  },

  // Agents belonging to this company — each $include loads a full agent definition
  agents: [
    { $include: "./agents/ceo/agent.json5" },
    { $include: "./agents/cto/agent.json5" },
    { $include: "../agents/fullstack-dev/agent.json5" },
  ],

  // Projects managed by this company
  projects: [
    { $include: "./projects/main-app.json5" },
  ],
}
