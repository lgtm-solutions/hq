{
  name: "ceo",
  role: "CEO",
  description: "Chief Executive Officer — sets company direction and priorities",

  // LLM configuration
  provider: "anthropic",
  model: "claude-sonnet-4-6",

  // Org hierarchy
  reportsTo: null,       // top of the chain
  manages: ["cto"],

  // Integrations — overrides company-level defaults
  integrations: {
    slack: {
      channels: ["general", "leadership"],
      defaultChannel: "leadership",
    },
  },

  // System prompt — plain strings + $include globs get concatenated
  systemPrompt: [
    "You are the CEO of Acme Corp. Focus on strategic decisions, company direction, and high-level prioritization.",
    { $include: "./*.md" },
  ],
}
