{
  // Values can be plain strings or ConfigValue objects:
  //   "value"                          — plain value
  //   { type: "env", key: "VAR" }      — load from environment variable
  //   { type: "file", path: "/path" }  — load from file on disk

  // Database — loaded from environment
  DATABASE_URL: { type: "env", key: "DATABASE_URL" },

  // LLM provider API keys
  ANTHROPIC_API_KEY: "sk-ant-...",
  OPENAI_API_KEY: "sk-...",

  // Slack — workspace-level config token (for Manifest API)
  SLACK_CONFIG_TOKEN: "xoxe.xoxp-...",
  SLACK_CONFIG_REFRESH_TOKEN: "xoxe.xoxr-...",

  // Slack — per-agent tokens
  SLACK_CEO_APP_TOKEN: "xapp-...",
  SLACK_CEO_BOT_TOKEN: "xoxb-...",
  SLACK_CTO_APP_TOKEN: "xapp-...",
  SLACK_CTO_BOT_TOKEN: "xoxb-...",
  SLACK_FULLSTACK_DEV_APP_TOKEN: "xapp-...",
  SLACK_FULLSTACK_DEV_BOT_TOKEN: "xoxb-...",

  // Slack — per-agent app credentials (stored after app creation)
  SLACK_CEO_APP_ID: "A0...",
  SLACK_CEO_CLIENT_ID: "...",
  SLACK_CEO_CLIENT_SECRET: "...",
  SLACK_CEO_SIGNING_SECRET: "...",
  SLACK_CTO_APP_ID: "A0...",
  SLACK_CTO_CLIENT_ID: "...",
  SLACK_CTO_CLIENT_SECRET: "...",
  SLACK_CTO_SIGNING_SECRET: "...",
}
