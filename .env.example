# Database
DATABASE_URL=postgresql://hq:hq@localhost:5432/hq

# Docker Compose (PostgreSQL)
POSTGRES_USER=hq
POSTGRES_PASSWORD=hq
POSTGRES_DB=hq
POSTGRES_PORT=5432

# HQ Config directory (defaults to ./examples)
HQ_CONFIG_DIR=

# MCP Server
MCP_PORT=3001

# ─── Slack Tokens ───
# Company-level (Acme Corp defaults)
SLACK_ACME_APP_TOKEN=xapp-...
SLACK_ACME_BOT_TOKEN=xoxb-...

# Agent: CEO
SLACK_CEO_APP_TOKEN=xapp-...
SLACK_CEO_BOT_TOKEN=xoxb-...

# Agent: CTO
SLACK_CTO_APP_TOKEN=xapp-...
SLACK_CTO_BOT_TOKEN=xoxb-...

# Agent: Full-Stack Developer
SLACK_FULLSTACK_DEV_APP_TOKEN=xapp-...
SLACK_FULLSTACK_DEV_BOT_TOKEN=xoxb-...
